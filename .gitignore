# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Environment / secrets
.env
*.pem
*.key

# Data — tracked by DVC, never by git
# Data is tracked by DVC, never by git -- but the pointer files must be
# committed. Git will not descend into an excluded directory, so the `!/data/**/`
# line re-including directories is load-bearing: without it the *.dvc exceptions
# below never match anything.
/data/**
!/data/**/
!/data/.gitkeep
!/data/**/*.dvc
!/data/**/.gitignore

# Experiment + model artifacts
/mlruns/
/outputs/
*.pt
*.pth
*.onnx
*.engine
*.plan

# Local service state
/infra/volumes/

# HuggingFace download cache; the checkpoint is pinned by revision in
# params.yaml, so this is a cache, not an input.
/.cache/
