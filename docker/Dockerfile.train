# syntax=docker/dockerfile:1

# ROCm userspace pinned to a release inside AMD's supported matrix (Ubuntu 24.04),
# executed against the host's amdgpu/KFD kernel driver. The host runs Ubuntu 26.04,
# which is NOT in that matrix -- which is precisely why training is containerised.
FROM rocm/dev-ubuntu-24.04:7.2.4

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Ubuntu 24.04 ships Python 3.12 as the system interpreter, so no deadsnakes/pyenv.
# libgl1 + libglib2.0-0 are opencv's runtime deps -- cheaper now than a rebuild later.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3-pip \
        git curl ca-certificates \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Installer tuning lives BELOW the apt layer on purpose: these change far more
# often than the OS packages, and above it they would invalidate apt's cache.
ENV PIP_BREAK_SYSTEM_PACKAGES=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_BREAK_SYSTEM_PACKAGES=1 \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=300

COPY --from=ghcr.io/astral-sh/uv:0.11.7 /uv /usr/local/bin/uv

WORKDIR /workspace

# The ROCm torch wheels are multi-GB and download-r2.pytorch.org stalls on slow links.
# A BuildKit cache mount keeps successfully fetched wheels across attempts, so a retry
# resumes rather than restarting; --timeout/--retries tolerate the stalls themselves.
# The cache mount is not a layer, so this costs nothing in final image size.
COPY docker/torch-requirements.txt /tmp/torch-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 300 --retries 10 -r /tmp/torch-requirements.txt

# Everything installs into the system interpreter (no venv) so it shares one
# site-packages with torch above.  --no-emit-project: the source tree is
# bind-mounted at runtime and reached via PYTHONPATH, never baked into the image.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --frozen --no-emit-project --no-hashes --all-groups -o /tmp/req.txt \
    && uv pip install --system -r /tmp/req.txt

ENV PYTHONPATH=/workspace/src

CMD ["/bin/bash"]
