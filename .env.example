# Copy to .env and fill in. Never commit .env.
#   generate secrets with:  openssl rand -hex 16

# --- Postgres: MLflow's metadata (runs, params, metrics) ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mlflow

# --- MinIO: artifact + dataset storage (S3-compatible) ---
MINIO_ROOT_USER=railedge
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- Client-side access to the above ---
# boto3 (used by both MLflow and DVC) reads the AWS_* names, so MinIO's
# credentials are supplied under those names. Same values, different spelling.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=railedge
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# --- Service state ---
# Absolute path, deliberately OUTSIDE the repo: moving or re-cloning the repo
# must not orphan the databases. Change per machine.
DATA_ROOT=/home/florian/rail-edge-data
